# kagero collector config — Rotel alternative, LGTM backend.
# Rotel takes env vars/CLI flags rather than a collector YAML.
# Rendered to KAGERO_COLLECTOR_CONFIG_OUT (0600) and read by the
# collector start wrapper (see collector/README.md "Spawn contract").
#
# CAVEATS (PoC-04 で確かめる):
# - Rotel batches internally; ADR-006 の「呼び出し側の flush = 到達」を
#   完全には表現できません。残量の検証が必要です。
# - ROTEL_OTEL_RESOURCE_ATTRIBUTES applies to ALL signals including
#   metrics, and Rotel has no per-signal resource scoping. To keep
#   ADR-008 we therefore stamp ONLY metric-safe attributes: instance /
#   tenant / session ids are NOT attached at all on this path. That means
#   Rotel cannot split telemetry by MicroVM id — per-VM drilldown requires
#   the OTel Collector or Alloy templates instead.

# Receiver — loopback only.
ROTEL_OTLP_GRPC_ENDPOINT=127.0.0.1:4317
ROTEL_OTLP_HTTP_ENDPOINT=127.0.0.1:{{KAGERO_OTLP_PORT}}

# Exporter — OTLP/HTTP to the unified LGTM gateway.
ROTEL_EXPORTER=otlp
ROTEL_OTLP_EXPORTER_PROTOCOL=http
ROTEL_OTLP_EXPORTER_ENDPOINT="{{KAGERO_ENDPOINT_LGTM}}"
# Custom headers are comma-separated key=value pairs; quote the value —
# the file is sourced by the spawn wrapper and would word-split on the
# space in "Basic <b64>".
ROTEL_OTLP_EXPORTER_CUSTOM_HEADERS="Authorization=Basic {{KAGERO_SECRET:basic_b64}}"

# Metric-safe identity only — no instance/tenant/session ids, they would
# land on metric labels and violate ADR-008 (see CAVEATS).
ROTEL_OTEL_RESOURCE_ATTRIBUTES=service.name=kagero,kagero.microvm.image.name={{KAGERO_IMAGE_NAME}},kagero.microvm.image.version={{KAGERO_IMAGE_VERSION}},kagero.microvm.size={{KAGERO_SIZE}},cloud.provider=aws,cloud.region={{KAGERO_REGION}}
