# kagero collector config — Rotel alternative, CloudWatch backend.
# Same caveats as lgtm.env.tmpl — Rotel stamps resource attributes on ALL
# signals, so only metric-safe attributes are set below and per-instance
# identity rides on the log-stream name instead (PoC-04 で確かめます)。

ROTEL_OTLP_GRPC_ENDPOINT=127.0.0.1:4317
ROTEL_OTLP_HTTP_ENDPOINT=127.0.0.1:{{KAGERO_OTLP_PORT}}

# Exporters — name:kind per signal, bound via ROTEL_EXPORTERS_<SIGNAL>.
# awsemf/awsxray exporter details (endpoints, region flags) are
# PoC-04/05 verification items; they use ambient execution-role creds.
ROTEL_EXPORTERS=logs:otlp,metrics:awsemf,traces:awsxray
ROTEL_EXPORTERS_LOGS=logs
ROTEL_EXPORTERS_METRICS=metrics
ROTEL_EXPORTERS_TRACES=traces

# Logs exporter — SigV4 with ambient execution-role credentials.
# CloudWatch Logs OTLP endpoint is per-signal: logs.<region>.amazonaws.com
# (region-derived unless KAGERO_ENDPOINT_CW_LOGS overrides it).
ROTEL_EXPORTER_LOGS_PROTOCOL=http
ROTEL_EXPORTER_LOGS_ENDPOINT="{{KAGERO_ENDPOINT_CW_LOGS}}"
ROTEL_EXPORTER_LOGS_AUTHENTICATOR=sigv4auth
# CloudWatch Logs OTLP requires log-group/stream headers.
ROTEL_EXPORTER_LOGS_CUSTOM_HEADERS="x-aws-log-group=/kagero/{{KAGERO_IMAGE_NAME}},x-aws-log-stream={{KAGERO_MICROVM_ID}}"

ROTEL_OTEL_RESOURCE_ATTRIBUTES=service.name=kagero,kagero.microvm.image.name={{KAGERO_IMAGE_NAME}},kagero.microvm.image.version={{KAGERO_IMAGE_VERSION}},kagero.microvm.size={{KAGERO_SIZE}},cloud.provider=aws,cloud.region={{KAGERO_REGION}}
