# kagero collector config — CloudWatch backend (OTel Collector contrib YAML).
#
# Same receiver/processor layout as collector/lgtm/; only exporters and
# auth differ (architecture.md §5: 送り先の部分だけ差し替える).
# SigV4 signs with the MicroVM's execution role — no secret fetch needed,
# which is why the agent only fetches KAGERO_SECRET_ARN when configured.

receivers:
  otlp:
    protocols:
      http:
        endpoint: 127.0.0.1:{{KAGERO_OTLP_PORT}}
      grpc:
        endpoint: 127.0.0.1:4317

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 128
    spike_limit_mib: 32

  # Identity stamped at RESOURCE level — app self-claims overwritten.
  resource/identity:
    attributes:
{{KAGERO_RESOURCE_ATTRS}}

  # Metrics keep only low-cardinality resource attributes (ADR-008).
  resource/metric_identity:
    attributes:
{{KAGERO_METRIC_ATTRS}}

  # Delete id keys on the app's own resource — resource attrs become
  # metric labels on Prometheus-style ingestion (ADR-008 enforced here).
  resource/strip_ids:
    attributes:
      - key: service.instance.id
        action: delete
      - key: faas.instance
        action: delete
      - key: kagero.tenant.id
        action: delete
      - key: kagero.session.id
        action: delete
      - key: kagero.suspend.duration_seconds
        action: delete
      - key: kagero.microvm.id
        action: delete
      - key: kagero.durable.execution.arn
        action: delete
      - key: kagero.durable.execution.name
        action: delete
      - key: kagero.durable.replay_count
        action: delete
      - key: kagero.durable.step.name
        action: delete
      - key: kagero.durable.attempt
        action: delete
      - key: kagero.error
        action: delete
      - key: kagero.usage.cause
        action: delete
      - key: kagero.usage.running_seconds
        action: delete
      - key: kagero.usage.burst_vcpu_seconds
        action: delete
      - key: kagero.usage.burst_gib_seconds
        action: delete
      - key: kagero.usage.suspend_seconds
        action: delete
      - key: kagero.usage.suspends
        action: delete
      - key: kagero.usage.resumes
        action: delete
      - key: http.request.id
        action: delete
      - key: enduser.id
        action: delete

  # Datapoint-level strip — a different level, same rule.
  attributes/strip_ids:
    actions:
      - key: service.instance.id
        action: delete
      - key: faas.instance
        action: delete
      - key: kagero.tenant.id
        action: delete
      - key: kagero.session.id
        action: delete
      - key: kagero.suspend.duration_seconds
        action: delete
      - key: kagero.microvm.id
        action: delete
      - key: kagero.durable.execution.arn
        action: delete
      - key: kagero.durable.execution.name
        action: delete
      - key: kagero.durable.replay_count
        action: delete
      - key: kagero.durable.step.name
        action: delete
      - key: kagero.durable.attempt
        action: delete
      - key: kagero.error
        action: delete
      - key: kagero.usage.cause
        action: delete
      - key: kagero.usage.running_seconds
        action: delete
      - key: kagero.usage.burst_vcpu_seconds
        action: delete
      - key: kagero.usage.burst_gib_seconds
        action: delete
      - key: kagero.usage.suspend_seconds
        action: delete
      - key: kagero.usage.suspends
        action: delete
      - key: kagero.usage.resumes
        action: delete
      - key: http.request.id
        action: delete
      - key: enduser.id
        action: delete

  # Scope-level strip — scope.attributes become otel_scope_* labels on
  # Prometheus-compatible ingestion (CloudWatch OTLP metrics queried via
  # PromQL), and the app can put ids there too (ADR-008).
  transform/strip_scope_ids:
    error_mode: ignore
    metric_statements:
      - context: scope
        statements:
          - delete_key(attributes, "service.instance.id")
          - delete_key(attributes, "faas.instance")
          - delete_key(attributes, "kagero.tenant.id")
          - delete_key(attributes, "kagero.session.id")
          - delete_key(attributes, "kagero.suspend.duration_seconds")
          - delete_key(attributes, "kagero.microvm.id")
          - delete_key(attributes, "kagero.durable.execution.arn")
          - delete_key(attributes, "kagero.durable.execution.name")
          - delete_key(attributes, "kagero.durable.replay_count")
          - delete_key(attributes, "kagero.durable.step.name")
          - delete_key(attributes, "kagero.durable.attempt")
          - delete_key(attributes, "kagero.error")
          - delete_key(attributes, "kagero.usage.cause")
          - delete_key(attributes, "kagero.usage.running_seconds")
          - delete_key(attributes, "kagero.usage.burst_vcpu_seconds")
          - delete_key(attributes, "kagero.usage.burst_gib_seconds")
          - delete_key(attributes, "kagero.usage.suspend_seconds")
          - delete_key(attributes, "kagero.usage.suspends")
          - delete_key(attributes, "kagero.usage.resumes")
          - delete_key(attributes, "http.request.id")
          - delete_key(attributes, "enduser.id")

# CloudWatch OTLP endpoints are per-signal, and each signs with a
# different SigV4 service name (AWS OTLP endpoints doc):
#   logs     → https://logs.{region}.amazonaws.com/v1/logs     (service: logs,
#              requires x-aws-log-group / x-aws-log-stream headers naming
#              an EXISTING group and stream — the endpoint creates neither)
#   metrics  → https://monitoring.{region}.amazonaws.com/v1/metrics (monitoring)
#   traces   → https://xray.{region}.amazonaws.com/v1/traces    (xray)
# The otlphttp exporter appends /v1/<signal> to the endpoint itself.
extensions:
  sigv4auth/metrics:
    region: "{{KAGERO_REGION}}"
    service: monitoring
  sigv4auth/logs:
    region: "{{KAGERO_REGION}}"
    service: logs
  sigv4auth/traces:
    region: "{{KAGERO_REGION}}"
    service: xray

exporters:
  otlphttp/cw_metrics:
    endpoint: "{{KAGERO_ENDPOINT_CW_METRICS}}"
    auth:
      authenticator: sigv4auth/metrics
    retry_on_failure:
      enabled: false
    sending_queue:
      enabled: false
    timeout: 5s

  otlphttp/cw_logs:
    endpoint: "{{KAGERO_ENDPOINT_CW_LOGS}}"
    auth:
      authenticator: sigv4auth/logs
    headers:
      # Fixed names, so both can be created before the first /run. Many
      # MicroVMs share the stream; resource/identity keeps them apart.
      x-aws-log-group: "/kagero/{{KAGERO_IMAGE_NAME}}"
      x-aws-log-stream: "otlp"
    retry_on_failure:
      enabled: false
    sending_queue:
      enabled: false
    timeout: 5s

  otlphttp/cw_traces:
    endpoint: "{{KAGERO_ENDPOINT_CW_TRACES}}"
    auth:
      authenticator: sigv4auth/traces
    retry_on_failure:
      enabled: false
    sending_queue:
      enabled: false
    timeout: 5s

service:
  telemetry:
    logs:
      level: warn
  extensions: [sigv4auth/metrics, sigv4auth/logs, sigv4auth/traces]
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, resource/metric_identity, resource/strip_ids, attributes/strip_ids, transform/strip_scope_ids]
      exporters: [otlphttp/cw_metrics]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, resource/identity]
      exporters: [otlphttp/cw_logs]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resource/identity]
      exporters: [otlphttp/cw_traces]
