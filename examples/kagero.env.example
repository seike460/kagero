# Non-secret kagero config — the same names the KageroMicrovmImage
# construct emits and the agent reads (crates/kagero-agent/src/config.rs).
# Secrets NEVER go in this file: set KAGERO_SECRET_ARN instead and the
# agent resolves it at /run (ADR-011).

KAGERO_BACKEND=lgtm                    # lgtm | cloudwatch | both —
  # "both" has no shipped template: mount a custom
  # KAGERO_COLLECTOR_CONFIG_TEMPLATE with both exporters (agent warns)
KAGERO_HOOK_PORT=2018
KAGERO_APP_HOOK_PORT=2019
KAGERO_OTLP_PORT=4318
KAGERO_ADMIN_PORT=2020
KAGERO_HOOK_TIMEOUT_MS=10000           # per-hook fallback
KAGERO_HOOK_TIMEOUT_MS_RUN=10000
KAGERO_HOOK_TIMEOUT_MS_SUSPEND=10000
KAGERO_HOOK_TIMEOUT_MS_RESUME=10000
KAGERO_HOOK_TIMEOUT_MS_TERMINATE=10000
KAGERO_HOOK_TIMEOUT_MS_READY=10000     # build hooks; the agent caps
KAGERO_HOOK_TIMEOUT_MS_VALIDATE=10000  # every per-hook timeout at 300s

KAGERO_MICROVM_BASELINE_GIB=2
KAGERO_MICROVM_BASELINE_VCPU=1
KAGERO_MICROVM_SIZE=2gb
KAGERO_MICROVM_IMAGE_NAME=my-app
KAGERO_MICROVM_IMAGE_VERSION=0.1.0
KAGERO_AWS_REGION=us-east-1

KAGERO_OTLP_ENDPOINT_LGTM=https://otlp.invalid   # PLACEHOLDER — set a real endpoint
# KAGERO_OTLP_ENDPOINT_CLOUDWATCH=https://...   # cloudwatch shared base —
#   optional: per-signal endpoints derive from KAGERO_AWS_REGION
#   (xray./monitoring./logs.<region>.amazonaws.com); use these overrides
#   only for VPC endpoints
# KAGERO_ENDPOINT_CW_TRACES=                    # https://xray.<region>.amazonaws.com
# KAGERO_ENDPOINT_CW_METRICS=                   # https://monitoring.<region>.amazonaws.com
# KAGERO_ENDPOINT_CW_LOGS=                      # https://logs.<region>.amazonaws.com
# KAGERO_OTLP_ENDPOINT=https://otlp.invalid     # LGTM fallback when
#   KAGERO_OTLP_ENDPOINT_LGTM is unset — the agent never uses it for
#   CloudWatch (set KAGERO_OTLP_ENDPOINT_CLOUDWATCH instead).
#   NEVER localhost:4318: that loops exports into the collector's receiver

KAGERO_COLLECTOR_BIN=/usr/local/bin/alloy
KAGERO_COLLECTOR_START=run             # build | run
KAGERO_COLLECTOR_ARGS='["run","--storage.path=/run/kagero/collector-data","{config}"]'
# ^ single quotes keep the JSON intact if the file is `source`d by bash
KAGERO_COLLECTOR_CONFIG_TEMPLATE=/etc/kagero/collector.alloy.tmpl
KAGERO_COLLECTOR_CONFIG_OUT=/tmp/collector.alloy
# KAGERO_COLLECTOR_RELOAD_URL=          # reload endpoint, if supported

# KAGERO_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:kagero-xxxxxx
#   ^ required by the shipped LGTM template — the rendered config fails
#     closed without it (expects JSON {"username","password"}).
# KAGERO_SECRETS_ENDPOINT=              # Secrets Manager REST override
# KAGERO_IMDS_ENDPOINT=                 # IMDS override

# KAGERO_APP_UID=1000                   # drop privileges (default nobody)
# KAGERO_APP_GID=1000
# KAGERO_HOOK_ALLOWED_PEERS=            # comma-separated CIDR allowlist —
#   unset denies loopback peers only (the in-VM app is the only loopback
#   source; set Lambda's real source addresses once PoC-02 confirms them)
# KAGERO_HOOK_RESERVE_FRACTION=0.1      # hook-time share for telemetry
# KAGERO_SAMPLE_INTERVAL_MS=1000        # usage sampler cadence
# KAGERO_CGROUP_PATH=                   # cgroup v2 metrics source
# KAGERO_TENANT_JSON_POINTER=/tenant    # extract tenant/session ids
# KAGERO_SESSION_JSON_POINTER=/session
