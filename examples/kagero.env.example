# Non-secret kagero config — the same names the KageroMicrovmImage
# construct emits and the agent reads (crates/kagero-agent/src/config.rs).
# Secrets NEVER go in this file: set KAGERO_SECRET_ARN instead and the
# agent resolves it at /run (ADR-011).
#
# One KEY=value per line; comments sit on their own lines. Load it in
# bash with `set -a; . ./kagero.env; set +a`. `docker run --env-file`
# keeps quotes as part of the value — drop the single quotes around
# KAGERO_COLLECTOR_ARGS there.

# lgtm | cloudwatch | both — "both" has no shipped template: mount a
# custom KAGERO_COLLECTOR_CONFIG_TEMPLATE with both exporters (agent warns)
KAGERO_BACKEND=lgtm
# Ports: 1-65535, all different and not 4317 (the collector's OTLP/gRPC
# port). The agent refuses 0 at startup — the OS would pick another port.
KAGERO_HOOK_PORT=2018
KAGERO_APP_HOOK_PORT=2019
KAGERO_OTLP_PORT=4318
KAGERO_ADMIN_PORT=2020
# Per-hook timeouts; KAGERO_HOOK_TIMEOUT_MS is the fallback. READY and
# VALIDATE are the build hooks. The agent caps every per-hook timeout
# at 300s.
KAGERO_HOOK_TIMEOUT_MS=10000
KAGERO_HOOK_TIMEOUT_MS_RUN=10000
KAGERO_HOOK_TIMEOUT_MS_SUSPEND=10000
KAGERO_HOOK_TIMEOUT_MS_RESUME=10000
KAGERO_HOOK_TIMEOUT_MS_TERMINATE=10000
KAGERO_HOOK_TIMEOUT_MS_READY=10000
KAGERO_HOOK_TIMEOUT_MS_VALIDATE=10000

KAGERO_MICROVM_BASELINE_GIB=2
KAGERO_MICROVM_BASELINE_VCPU=1
KAGERO_MICROVM_SIZE=2gb
KAGERO_MICROVM_IMAGE_NAME=my-app
KAGERO_MICROVM_IMAGE_VERSION=0.1.0
KAGERO_AWS_REGION=us-east-1

# PLACEHOLDER — set a real endpoint
KAGERO_OTLP_ENDPOINT_LGTM=https://otlp.invalid
# CloudWatch shared base — optional: per-signal endpoints derive from
# KAGERO_AWS_REGION (xray./monitoring./logs.<region>.amazonaws.com);
# use these overrides only for VPC endpoints
# KAGERO_OTLP_ENDPOINT_CLOUDWATCH=https://...
# KAGERO_ENDPOINT_CW_TRACES=https://xray.<region>.amazonaws.com
# KAGERO_ENDPOINT_CW_METRICS=https://monitoring.<region>.amazonaws.com
# KAGERO_ENDPOINT_CW_LOGS=https://logs.<region>.amazonaws.com
# LGTM fallback when KAGERO_OTLP_ENDPOINT_LGTM is unset — the agent never
# uses it for CloudWatch (set KAGERO_OTLP_ENDPOINT_CLOUDWATCH instead).
# NEVER localhost:4318: that loops exports into the collector's receiver
# KAGERO_OTLP_ENDPOINT=https://otlp.invalid

KAGERO_COLLECTOR_BIN=/usr/local/bin/alloy
# build | run
KAGERO_COLLECTOR_START=run
# Single quotes keep the JSON intact when bash sources this file
KAGERO_COLLECTOR_ARGS='["run","--storage.path=/run/kagero/collector-data","{config}"]'
KAGERO_COLLECTOR_CONFIG_TEMPLATE=/etc/kagero/collector.alloy.tmpl
KAGERO_COLLECTOR_CONFIG_OUT=/tmp/collector.alloy
# Reload endpoint, if supported
# KAGERO_COLLECTOR_RELOAD_URL=

# Required by the shipped LGTM template — the rendered config fails
# closed without it (expects JSON {"username","password"}).
# KAGERO_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:kagero-xxxxxx
# Secrets Manager REST override
# KAGERO_SECRETS_ENDPOINT=
# IMDS override
# KAGERO_IMDS_ENDPOINT=

# Drop privileges (default nobody)
# KAGERO_APP_UID=1000
# KAGERO_APP_GID=1000
# Comma-separated CIDRs or bare IPs allowed on the hook port. Unset, the
# agent rejects loopback peers only, so the app can still forge hooks
# (/run, /terminate) by connecting to the MicroVM's own IP. That risk
# stays open until PoC-02 confirms Lambda's source addresses; set them
# here then.
# KAGERO_HOOK_ALLOWED_PEERS=
# Hook-time share for telemetry
# KAGERO_HOOK_RESERVE_FRACTION=0.1
# Usage sampler cadence
# KAGERO_SAMPLE_INTERVAL_MS=1000
# cgroup v2 metrics source
# KAGERO_CGROUP_PATH=
# Extract tenant/session ids
# KAGERO_TENANT_JSON_POINTER=/tenant
# KAGERO_SESSION_JSON_POINTER=/session
